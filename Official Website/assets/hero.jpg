<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2000 900" preserveAspectRatio="xMidYMid slice" role="img" aria-label="The Novaris night sky over still water">
  <title>The Novaris night sky over still water</title>
  <!--
    A vector stand-in for the brand artwork, so the site looks finished before
    the photograph is added. If assets/hero.jpg exists it is used instead and
    this file is never shown, which is why the composition here deliberately
    leaves the centre clear for the wordmark and the horizon low.
  -->
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#03061c"/>
      <stop offset="0.45" stop-color="#0a1152"/>
      <stop offset="0.78" stop-color="#2a2a9c"/>
      <stop offset="0.94" stop-color="#7a5cf0"/>
      <stop offset="1" stop-color="#cbb6ff"/>
    </linearGradient>

    <radialGradient id="glow" cx="0.5" cy="0.96" r="0.6">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.85"/>
      <stop offset="0.25" stop-color="#b9a6ff" stop-opacity="0.45"/>
      <stop offset="1" stop-color="#5b3fd6" stop-opacity="0"/>
    </radialGradient>

    <linearGradient id="ribbon" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#8f6bff" stop-opacity="0"/>
      <stop offset="0.35" stop-color="#b79bff" stop-opacity="0.85"/>
      <stop offset="0.7" stop-color="#7fd0ff" stop-opacity="0.6"/>
      <stop offset="1" stop-color="#5b8cff" stop-opacity="0"/>
    </linearGradient>

    <linearGradient id="ribbon2" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#6f4bff" stop-opacity="0"/>
      <stop offset="0.4" stop-color="#a98cff" stop-opacity="0.7"/>
      <stop offset="1" stop-color="#6fe0ff" stop-opacity="0"/>
    </linearGradient>

    <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2b2a7e"/>
      <stop offset="0.25" stop-color="#141a5c"/>
      <stop offset="1" stop-color="#050733"/>
    </linearGradient>

    <radialGradient id="planet" cx="0.35" cy="0.35" r="0.75">
      <stop offset="0" stop-color="#8fb4ff"/>
      <stop offset="0.6" stop-color="#2c56c8"/>
      <stop offset="1" stop-color="#0a1348"/>
    </radialGradient>

    <filter id="soft" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="18"/>
    </filter>
    <filter id="softer" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="44"/>
    </filter>
    <filter id="stars" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur stdDeviation="1.1"/>
    </filter>
  </defs>

  <rect width="2000" height="900" fill="url(#sky)"/>

  <!-- Star field. Denser and brighter toward the top, thinning toward the
       horizon glow, which is how a long exposure actually looks. -->
  <g fill="#ffffff" filter="url(#stars)">
    <g opacity="0.9">
      <circle cx="120" cy="70" r="1.6"/><circle cx="300" cy="150" r="1.1"/><circle cx="415" cy="60" r="1.9"/>
      <circle cx="520" cy="210" r="1.2"/><circle cx="660" cy="95" r="1.5"/><circle cx="745" cy="255" r="1"/>
      <circle cx="880" cy="130" r="1.7"/><circle cx="960" cy="45" r="1.1"/><circle cx="1085" cy="190" r="1.4"/>
      <circle cx="1190" cy="85" r="1.8"/><circle cx="1300" cy="235" r="1"/><circle cx="1415" cy="120" r="1.6"/>
      <circle cx="1520" cy="60" r="1.2"/><circle cx="1610" cy="200" r="1.5"/><circle cx="1720" cy="110" r="1.8"/>
      <circle cx="1830" cy="180" r="1.1"/><circle cx="1910" cy="70" r="1.4"/><circle cx="60" cy="185" r="1.3"/>
      <circle cx="210" cy="300" r="1.1"/><circle cx="390" cy="265" r="1.5"/><circle cx="845" cy="330" r="1.1"/>
      <circle cx="1010" cy="300" r="1.4"/><circle cx="1255" cy="345" r="1"/><circle cx="1470" cy="290" r="1.5"/>
      <circle cx="1665" cy="320" r="1.2"/><circle cx="1875" cy="300" r="1.4"/>
    </g>
    <g opacity="0.45">
      <circle cx="170" cy="130" r="0.9"/><circle cx="260" cy="60" r="0.8"/><circle cx="470" cy="175" r="0.9"/>
      <circle cx="600" cy="290" r="0.8"/><circle cx="700" cy="45" r="0.9"/><circle cx="820" cy="200" r="0.8"/>
      <circle cx="900" cy="375" r="0.9"/><circle cx="1000" cy="230" r="0.8"/><circle cx="1150" cy="60" r="0.9"/>
      <circle cx="1240" cy="270" r="0.8"/><circle cx="1360" cy="195" r="0.9"/><circle cx="1450" cy="40" r="0.8"/>
      <circle cx="1560" cy="330" r="0.9"/><circle cx="1690" cy="150" r="0.8"/><circle cx="1780" cy="265" r="0.9"/>
      <circle cx="1930" cy="230" r="0.8"/><circle cx="90" cy="255" r="0.9"/><circle cx="330" cy="390" r="0.8"/>
      <circle cx="560" cy="355" r="0.9"/><circle cx="1120" cy="395" r="0.8"/><circle cx="1350" cy="60" r="0.9"/>
      <circle cx="1595" cy="270" r="0.8"/><circle cx="1855" cy="215" r="0.9"/>
    </g>
    <!-- A few bright stars with visible diffraction spikes. -->
    <g opacity="0.95">
      <g transform="translate(516 88)">
        <path d="M0-16 3-3 16 0 3 3 0 16-3 3-16 0-3-3Z" fill="#ffffff"/>
        <circle r="2.2" fill="#ffffff"/>
      </g>
      <g transform="translate(1428 222)">
        <path d="M0-13 2.5-2.5 13 0 2.5 2.5 0 13-2.5 2.5-13 0-2.5-2.5Z" fill="#dfe8ff"/>
        <circle r="1.8" fill="#ffffff"/>
      </g>
      <g transform="translate(175 158)">
        <path d="M0-10 2-2 10 0 2 2 0 10-2 2-10 0-2-2Z" fill="#dfe8ff"/>
        <circle r="1.5" fill="#ffffff"/>
      </g>
    </g>
  </g>

  <!-- The planet, cropped by the top right corner as in the reference. -->
  <g>
    <circle cx="1830" cy="-40" r="330" fill="url(#planet)" opacity="0.95"/>
    <circle cx="1830" cy="-40" r="330" fill="none" stroke="#cfe0ff" stroke-opacity="0.5" stroke-width="3"/>
    <ellipse cx="1760" cy="60" rx="210" ry="90" fill="#0d1a52" opacity="0.28"/>
    <ellipse cx="1900" cy="-120" rx="180" ry="70" fill="#0d1a52" opacity="0.22"/>
  </g>

  <!-- Aurora ribbons sweeping across the sky. -->
  <g filter="url(#soft)">
    <path d="M-100 470 C 300 300, 620 560, 1010 380 S 1750 250, 2100 400" stroke="url(#ribbon)" stroke-width="26" fill="none" stroke-linecap="round" opacity="0.75"/>
    <path d="M-100 560 C 380 430, 700 640, 1080 470 S 1800 340, 2100 470" stroke="url(#ribbon2)" stroke-width="18" fill="none" stroke-linecap="round" opacity="0.6"/>
  </g>
  <g filter="url(#softer)" opacity="0.55">
    <path d="M-100 420 C 350 260, 650 500, 1020 330 S 1780 200, 2100 340" stroke="#7a5cf0" stroke-width="70" fill="none" stroke-linecap="round"/>
    <path d="M-100 520 C 420 380, 760 600, 1120 430 S 1820 300, 2100 430" stroke="#4f7dff" stroke-width="54" fill="none" stroke-linecap="round"/>
  </g>

  <!-- Horizon light. -->
  <rect x="0" y="0" width="2000" height="900" fill="url(#glow)"/>

  <!-- Mountain silhouettes, layered so the ridge line reads as distance. -->
  <g fill="#050a2c">
    <path d="M0 640 L120 596 L210 620 L330 560 L430 604 L520 574 L640 622 L760 590 L880 630 L1000 596 L1120 636 L1240 602 L1360 640 L1500 610 L1620 648 L1740 616 L1860 652 L2000 622 L2000 720 L0 720 Z" opacity="0.9"/>
  </g>
  <g fill="#03061c">
    <path d="M0 668 L90 646 L180 664 L300 634 L400 660 L520 640 L640 672 L760 648 L900 678 L1040 652 L1180 682 L1320 656 L1460 684 L1600 660 L1740 688 L1880 664 L2000 690 L2000 760 L0 760 Z"/>
  </g>

  <!-- Water, with a bright path of reflected light down the middle. -->
  <rect x="0" y="700" width="2000" height="200" fill="url(#water)"/>
  <g filter="url(#soft)" opacity="0.5">
    <rect x="880" y="700" width="240" height="200" fill="#b9a6ff"/>
    <rect x="820" y="700" width="120" height="200" fill="#ffffff" opacity="0.6"/>
  </g>
  <g opacity="0.3">
    <rect x="0" y="712" width="2000" height="3" fill="#cfc0ff"/>
    <rect x="0" y="740" width="2000" height="2" fill="#a99cff"/>
    <rect x="0" y="772" width="2000" height="3" fill="#8f86ff"/>
    <rect x="0" y="812" width="2000" height="2" fill="#6f6ae0"/>
    <rect x="0" y="856" width="2000" height="3" fill="#4f4cae"/>
  </g>
</svg>
