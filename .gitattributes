# Normalise line endings in the repository, and check them out correctly per
# platform. Without this, a Windows checkout rewrites every file's endings and
# the next diff is unreadable.
* text=auto

*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.xml  text eol=lf
*.toml text eol=lf
*.svg  text eol=lf

# Windows scripts have to stay CRLF or they will not run from cmd.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary, never touched.
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.woff  binary
*.woff2 binary
*.exe  binary
*.blockmap binary
*.pdf  binary
