{
  "name": "novaris-browser",
  "version": "0.9.0",
  "description": "A secure, glass-inspired desktop web browser built with Electron and Chromium.",
  "main": "electron/main.js",
  "author": {
    "name": "Novaris Browser",
    "email": "maintainer@novaris.example"
  },
  "homepage": "https://novaris-browser.github.io",
  "license": "MIT",
  "desktopName": "com.novaris.browser",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "prebuild": "node scripts/write-update-channel.mjs",
    "build": "vite build",
    "start": "electron .",
    "test": "vitest run",
    "engine:spike": "node scripts/engine-spike.mjs",
    "dist": "npm run build && electron-builder --win && node scripts/write-release-notes.mjs",
    "dist:win": "npm run build && electron-builder --win && node scripts/write-release-notes.mjs",
    "dist:linux": "bash scripts/build-linux.sh",
    "publish:check": "node scripts/publish-release.mjs --dry-run",
    "publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.1",
    "wrangler": "^4.142.0"
  },
  "build": {
    "appId": "com.novaris.browser",
    "productName": "Novaris Browser",
    "asar": true,
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.yladevs.com"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Novaris-Browser-${version}-Setup.${ext}",
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Novaris-Browser-${version}-Linux.${ext}",
      "category": "Network",
      "syncDesktopName": true,
      "synopsis": "Secure, glass-inspired desktop web browser",
      "description": "A privacy-focused desktop web browser built on Electron and Chromium, with vertical tabs, workspaces, an ad blocker, a local encrypted vault, and no account.",
      "desktop": {
        "entry": {
          "Categories": "Network;WebBrowser;",
          "MimeType": "text/html;text/xml;application/xhtml+xml;application/xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/novaris;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "priority": "optional"
    },
    "protocols": [
      {
        "name": "Novaris Browser",
        "schemes": [
          "novaris"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    }
  }
}
